1='45' x2='145' y2='45' stroke='#0f172a' stroke-width='2'/><text x='150' y='50' class='atom' fill='#0f172a'>C</text><line x1='155' y1='33' x2='155' y2='12' stroke='#0f172a' stroke-width='2'/><line x1='161' y1='33' x2='161' y2='12' stroke='#0f172a' stroke-width='2'/><text x='153' y='5' class='atom' fill='#dc2626'>O</text><line x1='160' y1='52' x2='175' y2='67' stroke='#0f172a' stroke-width='2'/><text x='177' y='80' class='atom' fill='#0f172a'>H</text><path d='M 80 40 Q 82 20 100 20 Q 115 20 125 38' class='arrow' marker-end='url(#red-arrow)'/><path d='M 158 30 Q 170 25 170 12' class='arrow' marker-end='url(#red-arrow)'/><text x='35' y='110' font-family='Arial' font-size='11' font-weight='bold' fill='#0284c7'>Step 1: Enolate Formation</text></g><g transform='translate(200, 75)'><line x1='0' y1='0' x2='30' y2='0' class='rxn-arrow' marker-end='url(#blue-arrow)'/><text x='5' y='-8' font-family='Arial' font-size='10' fill='#dc2626'>−H2O</text></g><g transform='translate(245, 40)'><text x='0' y='50' class='atom' fill='#0f172a'>[ H<tspan font-size='10' dy='3'>2</tspan><tspan font-size='14' dy='-3'>C</tspan></text><line x1='28' y1='45' x2='48' y2='45' stroke='#0f172a' stroke-width='2'/><text x='50' y='50' class='atom' fill='#0f172a'>C(O<tspan font-size='10' dy='-6'>−</tspan><tspan font-size='14' dy='6'>)H</tspan></text><line x1='90' y1='45' x2='105' y2='45' class='res-arrow'/><text x='110' y='50' class='atom' fill='#0f172a'>H<tspan font-size='10' dy='3'>2</tspan><tspan font-size='14' dy='-3'>C</tspan><tspan font-size='10' dy='-6'>−</tspan><tspan font-size='14' dy='6'>−CH=O ]</tspan></text><text x='15' y='110' font-family='Arial' font-size='11' font-weight='bold' fill='#0284c7'>Resonance-Stabilized Enolate</text></g></g><g transform='translate(15, 175)'><g transform='translate(10, 40)'><text x='0' y='50' class='atom' fill='#0f172a'>H<tspan font-size='10' dy='3'>3</tspan><tspan font-size='14' dy='-3'>C−C(=O)H</tspan></text><text x='80' y='50' class='atom' fill='#0284c7'>+</text><text x='100' y='50' class='atom' fill='#0f172a'>H<tspan font-size='10' dy='3'>2</tspan><tspan font-size='14' dy='-3'>C</tspan><tspan font-size='10' dy='-6'>−</tspan><tspan font-size='14' dy='6'>−CH=O</tspan></text><path d='M 105 40 Q 80 15 50 40' class='arrow' marker-end='url(#red-arrow)'/><text x='20' y='110' font-family='Arial' font-size='11' font-weight='bold' fill='#0284c7'>Step 2: Nucleophilic Attack</text></g><g transform='translate(230, 75)'><line x1='0' y1='0' x2='30' y2='0' class='rxn-arrow' marker-end='url(#blue-arrow)'/></g><g transform='translate(270, 40)'><text x='0' y='50' class='atom' fill='#0f172a'>H<tspan font-size='10' dy='3'>3</tspan><tspan font-size='14' dy='-3'>C−CH(O</tspan><tspan font-size='10' dy='-6'>−</tspan><tspan font-size='14' dy='6'>)−CH<tspan font-size='10' dy='3'>2</tspan>−CH=O</tspan></text><text x='200' y='50' class='atom' fill='#0284c7'>+ H<tspan font-size='10' dy='3'>2</tspan><tspan font-size='14' dy='-3'>O</tspan></text><path d='M 230 40 Q 200 20 120 40' class='arrow' marker-end='url(#red-arrow)'/><text x='15' y='110' font-family='Arial' font-size='11' font-weight='bold' fill='#0284c7'>Step 3: Alkoxide Protonation</text></g><g transform='translate(540, 75)'><line x1='0' y1='0' x2='30' y2='0' class='rxn-arrow' marker-end='url(#blue-arrow)'/><text x='5' y='-8' font-family='Arial' font-size='10' fill='#16a34a'>−OH−</text></g><g transform='translate(580, 40)'><text x='0' y='50' class='atom' fill='#16a34a'>H<tspan font-size='10' dy='3'>3</tspan><tspan font-size='14' dy='-3'>C−CH(OH)−CH<tspan font-size='10' dy='3'>2</tspan>−CHO</tspan></text><text x='10' y='110' font-family='Arial' font-size='11' font-weight='bold' fill='#16a34a'>β-Hydroxy Aldehyde (Aldol)</text></g></g><g transform='translate(15, 290)'><rect x='10' y='10' width='730' height='45' rx='6' fill='#fee2e2'/><text x='25' y='28' font-family='Arial' font-size='11' font-weight='bold' fill='#b91c1c'>Step 4: E1cb Elimination (Dehydration Drive to Conjugation):</text><text x='25' y='44' font-family='Arial' font-size='11' fill='#991b1b'>H3C−CH(OH)−CH2−CHO + OH−  ►  H3C−CH(OH)−CH(−)−CHO  ►  H3C−CH=CH−CHO (Crotonaldehyde, α,β-unsaturated) + H2O + OH−</text></g></g><g transform='translate(20, 420)'><rect class='card' width='760' height='340' rx='8'/><text x='15' y='25' class='subtitle'>SECTION 2: Regioselective Enolate Generation (Kinetic vs Thermodynamic Control)</text><g transform='translate(35, 45)'><rect x='0' y='0' width='320' height='270' rx='8' fill='#f0f9ff' stroke='#0284c7'/><text x='15' y='25' font-family='Arial' font-size='13' font-weight='bold' fill='#0369a1'>A. Kinetic Enolate Control</text><text x='15' y='45' font-family='Arial' font-size='11' fill='#334155'>• Reagents: LDA (Lithium Diisopropylamide) / THF / −78°C</text><text x='15' y='60' font-family='Arial' font-size='11' fill='#334155'>• Deprotonation at Less Hindered α-carbon (Fastest rate)</text><g transform='translate(80, 80)'><polygon points='30,30 55,45 55,75 30,90 5,75 5,45' fill='none' stroke='#0f172a' stroke-width='2'/><line x1='55' y1='45' x2='75' y2='35' stroke='#0f172a' stroke-width='2'/><text x='78' y='35' class='atom' fill='#0f172a'>CH<tspan font-size='10' dy='3'>3</tspan></text><line x1='30' y1='30' x2='30' y2='10' stroke='#0f172a' stroke-width='2'/><text x='25' y='5' class='atom' fill='#dc2626'>O</text><text x='105' y='55' font-family='Arial' font-size='16' font-weight='bold' fill='#0284c7'>+</text><text x='125' y='55' font-family='Arial' font-size='12' font-weight='bold' fill='#dc2626'>LDA / −78°C</text><line x1='125' y1='65' x2='200' y2='65' class='rxn-arrow' marker-end='url(#blue-arrow)'/></g><g transform='translate(80, 160)'><polygon points='30,30 55,45 55,75 30,90 5,75 5,45' fill='none' stroke='#0f172a' stroke-width='2'/><line x1='55' y1='45' x2='75' y2='35' stroke='#0f172a' stroke-width='2'/><text x='78' y='35' class='atom' fill='#0f172a'>CH<tspan font-size='10' dy='3'>3</tspan></text><line x1='30' y1='30' x2='30' y2='10' stroke='#0f172a' stroke-width='2'/><text x='25' y='5' class='atom' fill='#dc2626'>O<tspan font-size='10' dy='-6'>−</tspan></text><line x1='5' y1='45' x2='-15' y2='35' stroke='#0284c7' stroke-width='3'/><text x='-35' y='30' class='atom' fill='#0284c7'>Li<tspan font-size='10' dy='-6'>+</tspan></text></g><rect x='15' y='225' width='290' height='35' rx='4' fill='#e0f2fe'/><text x='22' y='246' font-family='Arial' font-size='10' font-weight='bold' fill='#0369a1'>Kinetic Product: Less-Substituted Double Bond</text></g><g transform='translate(400, 45)'><rect x='0' y='0' width='320' height='270' rx='8' fill='#fefce8' stroke='#ca8a04'/><text x='15' y='25' font-family='Arial' font-size='13' font-weight='bold' fill='#854d0e'>B. Thermodynamic Enolate Control</text><text x='15' y='45' font-family='Arial' font-size='11' fill='#334155'>• Reagents: NaOEt / EtOH / 25°C or Reflux</text><text x='15' y='60' font-family='Arial' font-size='11' fill='#334155'>• Reversible Equilibrium favors More Substituted Enolate</text><g transform='translate(80, 80)'><polygon points='30,30 55,45 55,75 30,90 5,75 5,45' fill='none' stroke='#0f172a' stroke-width='2'/><line x1='55' y1='45' x2='75' y2='35' stroke='#0f172a' stroke-width='2'/><text x='78' y='35' class='atom' fill='#0f172a'>CH<tspan font-size='10' dy='3'>3</tspan></text><line x1='30' y1='30' x2='30' y2='10' stroke='#0f172a' stroke-width='2'/><text x='25' y='5' class='atom' fill='#dc2626'>O</text><text x='105' y='55' font-family='Arial' font-size='16' font-weight='bold' fill='#ca8a04'>+</text><text x='125' y='55' font-family='Arial' font-size='12' font-weight='bold' fill='#ca8a04'>NaOEt / 25°C</text><line x1='125' y1='65' x2='200' y2='65' class='rxn-arrow' marker-end='url(#blue-arrow)'/></g><g transform='translate(80, 160)'><polygon points='30,30 55,45 55,75 30,90 5,75 5,45' fill='none' stroke='#0f172a' stroke-width='2'/><line x1='55' y1='45' x2='75' y2='35' stroke='#ca8a04' stroke-width='3'/><text x='78' y='35' class='atom' fill='#0f172a'>CH<tspan font-size='10' dy='3'>3</tspan></text><line x1='30' y1='30' x2='30' y2='10' stroke='#0f172a' stroke-width='2'/><text x='25' y='5' class='atom' fill='#dc2626'>O<tspan font-size='10' dy='-6'>−</tspan></text></g><rect x='15' y='225' width='290' height='35' rx='4' fill='#fef9c3'/><text x='22' y='246' font-family='Arial' font-size='10' font-weight='bold' fill='#854d0e'>Thermodynamic Product: More-Substituted Double Bond</text></g></g><g transform='translate(20, 775)'><rect class='card' width='760' height='350' rx='8'/><text x='15' y='25' class='subtitle'>SECTION 3: Stereoselective Aldol (Zimmerman-Traxler Chair Transition State)</text><g transform='translate(25, 40)'><rect x='0' y='0' width='350' height='285' rx='8' fill='#f8fafc' stroke='#cbd5e1'/><text x='15' y='22' font-family='Arial' font-size='12' font-weight='bold' fill='#2563eb'>(E)-Lithium Enolate  ►  ANTI-Aldol Product</text><g transform='translate(40, 40)'><path d='M 40 40 L 90 20 L 140 40 L 140 90 L 90 110 L 40 90 Z' fill='none' stroke='#0f172a' stroke-width='2'/><text x='85' y='18' class='atom' fill='#2563eb'>Li</text><text x='142' y='42' class='atom' fill='#dc2626'>O</text><text x='30' y='42' class='atom' fill='#dc2626'>O</text><text x='145' y='95' class='atom' fill='#0f172a'>C(R<tspan font-size='9' dy='2'>1</tspan><tspan font-size='14' dy='-2'>)</tspan></text><text x='85' y='125' class='atom' fill='#0284c7'>R<tspan font-size='9' dy='2'>2</tspan><tspan font-size='14' dy='-2'> (Equatorial)</tspan></text><line x1='90' y1='110' x2='90' y2='128' stroke='#0284c7' stroke-width='2'/><text x='15' y='95' class='atom' fill='#0284c7'>R<tspan font-size='9' dy='2'>3</tspan><tspan font-size='14' dy='-2'> (Equatorial)</tspan></text><line x1='40' y1='90' x2='15' y2='90' stroke='#0284c7' stroke-width='2'/></g><rect x='15' y='230' width='320' height='40' rx='4' fill='#dbeafe'/><text x='22' y='248' font-family='Arial' font-size='10' font-weight='bold' fill='#1e40af'>1,3-Diaxial Interactions Minimized</text><text x='22' y='260' font-family='Arial' font-size='10' fill='#1e3a8a'>R2 and R3 substituents both occupy equatorial positions.</text></g><g transform='translate(385, 40)'><rect x='0' y='0' width='350' height='285' rx='8' fill='#f8fafc' stroke='#cbd5e1'/><text x='15' y='22' font-family='Arial' font-size='12' font-weight='bold' fill='#dc2626'>(Z)-Lithium Enolate  ►  SYN-Aldol Product</text><g transform='translate(40, 40)'><path d='M 40 40 L 90 20 L 140 40 L 140 90 L 90 110 L 40 90 Z' fill='none' stroke='#0f172a' stroke-width='2'/><text x='85' y='18' class='atom' fill='#2563eb'>Li</text><text x='142' y='42' class='atom' fill='#dc2626'>O</text><text x='30' y='42' class='atom' fill='#dc2626'>O</text><text x='145' y='95' class='atom' fill='#0f172a'>C(R<tspan font-size='9' dy='2'>1</tspan><tspan font-size='14' dy='-2'>)</tspan></text><text x='85' y='125' class='atom' fill='#0284c7'>R<tspan font-size='9' dy='2'>2</tspan><tspan font-size='14' dy='-2'> (Equatorial)</tspan></text><line x1='90' y1='110' x2='90' y2='128' stroke='#0284c7' stroke-width='2'/><text x='30' y='125' class='atom' fill='#dc2626'>R<tspan font-size='9' dy='2'>3</tspan><tspan font-size='14' dy='-2'> (Axial)</tspan></text><line x1='40' y1='90' x2='40' y2='110' stroke='#dc2626' stroke-width='2'/></g><rect x='15' y='230' width='320' height='40' rx='4' fill='#fee2e2'/><text x='22' y='248' font-family='Arial' font-size='10' font-weight='bold' fill='#991b1b'>Chair-Like 6-Membered Transition State</text><text x='22' y='260' font-family='Arial' font-size='10' fill='#7f1d1d'>R3 axial placement delivers complementary SYN diastereomer.</text></g></g></svg></div>"
